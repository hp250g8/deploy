# Hygienic Cart Loyalty Rewards — copy this file to .env.local
# and fill in the real values. NEVER commit .env.local to GitHub.
# Never put these values in frontend code or share them in chat.

# --- Supabase (required for real shared data) ---
# From Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- SMS (optional — leave blank until you have a provider) ---
# SMS stays NOT CONNECTED while these are blank. Nothing is ever
# claimed sent. Messages are written to the SMS log in the app.
# Provider: "msg91" or "fast2sms" (leave blank = not configured)
SMS_PROVIDER=
# MSG91 — from msg91.com dashboard. DLT registration is required in India.
MSG91_API_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID_APPROVAL=
MSG91_TEMPLATE_ID_DECLINE=
MSG91_TEMPLATE_ID_REWARD=
# Fast2SMS — from fast2sms.com dashboard. DLT registration is required.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID_APPROVAL=
# Admin (owner) mobile number that gets the "new purchase request" SMS
# once SMS is connected. 10 digits, India. Example: 9075802072
ADMIN_MOBILE=
